<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Company>Microsoft France</Company>
    <Authors>Microsoft France</Authors>
    <Copyright>2010</Copyright>
    <Product>XAdES Starter Kit</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.14" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Código portado de las bibliotecas anteriores (firma, certificados, HTTP): las APIs marcadas obsoletas se mantienen porque la firma está validada con la DIAN y cambiarlas arriesga el resultado. -->
    <NoWarn>$(NoWarn);SYSLIB0021;SYSLIB0047;SYSLIB0057</NoWarn>
  </PropertyGroup>

</Project>
